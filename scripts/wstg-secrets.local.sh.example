#!/usr/bin/env bash
# Copy to scripts/wstg-secrets.local.sh (gitignored). Wrappers source this file.
#
# CRITICAL: Put ONLY export lines below. Never run npm or ./scripts/run-wstg-evidence.sh here
# or you get infinite recursion and: fork: Resource temporarily unavailable
#
# Use SINGLE QUOTES so ! and @ in passwords are safe in bash.

export WSTG_IDNT_TEST_WRONG_PASSWORD='AnyWrongPasswordNotTheRealOne!99'
export WSTG_ATHZ_PASSWORD='REPLACE_WITH_BUYER1_REAL_PASSWORD'
